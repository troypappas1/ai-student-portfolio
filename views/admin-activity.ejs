<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Capture — <%= activity.name %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="topbar">
    <div class="brand">Capture</div>
    <div class="row">
      <span class="who"><%= user.name %> · admin</span>
      <form method="POST" action="/logout"><button class="btn ghost small" type="submit">Sign out</button></form>
    </div>
  </div>
  <div class="wrap">
    <p><a href="/admin/activities">&larr; Back to activities</a></p>
    <h2><%= activity.name %> <span class="muted">(<%= activity.academic_year %>)</span></h2>

    <div class="card">
      <table>
        <thead><tr><th>Student</th></tr></thead>
        <tbody><% roster.forEach(function(s) { %><tr><td><%= s.name %></td></tr><% }); %></tbody>
      </table>
      <% if (roster.length === 0) { %><p class="muted">No members yet.</p><% } %>
    </div>

    <h3>Add a member</h3>
    <div class="card">
      <form method="POST" action="/admin/activities/<%= activity.id %>/enroll" class="row">
        <select name="student_id" style="max-width:260px;">
          <% available.forEach(function(s) { %><option value="<%= s.id %>"><%= s.name %></option><% }); %>
        </select>
        <button class="btn small" type="submit">Add</button>
      </form>
      <% if (available.length === 0) { %><p class="muted">All students are already members.</p><% } %>
    </div>
  </div>
</body>
</html>
