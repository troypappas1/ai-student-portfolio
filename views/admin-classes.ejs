<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Capture — Classes</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="topbar">
    <div class="brand">Capture</div>
    <div class="row">
      <span class="who"><%= user.name %> · admin</span>
      <form method="POST" action="/logout"><button class="btn ghost small" type="submit">Sign out</button></form>
    </div>
  </div>
  <div class="wrap">
    <div class="nav-links" style="margin-bottom:20px;">
      <a href="/admin">Review &amp; roster</a>
      <a href="/admin/classes" class="active">Classes</a>
      <a href="/admin/activities">Activities</a>
      <a href="/admin/audit">Audit log</a>
    </div>

    <h2>Classes</h2>
    <div class="card">
      <table>
        <thead><tr><th>Name</th><th>Year</th><th>Teacher</th><th>Students</th><th></th></tr></thead>
        <tbody>
          <% classes.forEach(function(c) { %>
            <tr>
              <td><%= c.name %> <span class="muted"><%= c.course_code || '' %></span></td>
              <td><%= c.academic_year %></td>
              <td><%= c.teacher_name || '(unassigned)' %></td>
              <td><%= c.student_count %></td>
              <td><a href="/admin/classes/<%= c.id %>">Roster &rarr;</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <% if (classes.length === 0) { %><p class="muted">No classes yet.</p><% } %>
    </div>

    <h2>Add a class</h2>
    <div class="card">
      <form method="POST" action="/admin/classes">
        <div class="grid-2">
          <div>
            <label for="name">Class name</label>
            <input id="name" name="name" required placeholder="Physics">
          </div>
          <div>
            <label for="course_code">Course code (optional)</label>
            <input id="course_code" name="course_code" placeholder="SCI-301">
          </div>
        </div>
        <div class="grid-2">
          <div>
            <label for="academic_year">Academic year</label>
            <input id="academic_year" name="academic_year" required placeholder="2026-2027">
          </div>
          <div>
            <label for="teacher_id">Teacher</label>
            <select id="teacher_id" name="teacher_id">
              <option value="">(unassigned)</option>
              <% teachers.forEach(function(t) { %><option value="<%= t.id %>"><%= t.name %></option><% }); %>
            </select>
          </div>
        </div>
        <div style="margin-top:14px;"><button class="btn clay" type="submit">Create class</button></div>
      </form>
    </div>
  </div>
</body>
</html>
