<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Capture — Sonoma Academy</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="login-shell">
    <div class="login-box">
      <p class="school-name">SONOMA ACADEMY</p>
      <h1>Capture</h1>
      <p class="tagline">Your work. Your journey. Your story.</p>
      <form method="POST" action="/login">
        <label for="pin">PIN</label>
        <input id="pin" name="pin" maxlength="8" autofocus autocomplete="off" placeholder="XXXXXXXX">
        <% if (error) { %><div class="error"><%= error %></div><% } %>
        <div style="margin-top:18px;">
          <button class="btn" type="submit" style="width:100%;">Sign in</button>
        </div>
      </form>
      <p class="muted" style="margin-top:22px;">Parents &amp; guardians sign in with the PIN shared with you by the student.</p>
    </div>
  </div>
</body>
</html>
