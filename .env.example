# Copy this file to .env and fill in real values before running.

# Any long random string — used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite file lives. On Railway, point this at a mounted volume
# (e.g. /data/ledger.db) so data survives redeploys.
DATABASE_PATH=./data/ledger.db

PORT=3000

# Optional. If set, artifact summaries are drafted by the Claude API.
# If left blank, a simple built-in fallback summarizer is used instead
# (fine for local testing, but teachers will notice it's generic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
